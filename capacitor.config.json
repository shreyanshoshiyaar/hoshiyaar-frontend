{
  "appId": "com.hoshiyaarlearning.app",
  "appName": "HoshiYaar",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0f0f1a",
      "showSpinner": false,
      "launchAutoHide": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "appId": "com.hoshiyaarlearning.app",
      "version": "0.0.0",
      "autoUpdate": "always",
      "autoSplashscreen": true
    }
  }
}
