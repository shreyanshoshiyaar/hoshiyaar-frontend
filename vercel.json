{
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-index.xml",
      "destination": "https://api.hoshiyaar.info/sitemap.xml"
    },
    {
      "source": "/blogs/:path*",
      "destination": "/api/render?path=:path*"
    },
    {
      "source": "/blogs",
      "destination": "/api/render?path=blogs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
